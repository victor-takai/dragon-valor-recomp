+void edge_page(const fs::path& root) {
+    /* An 8-bit page at x 960 runs past VRAM's right edge (960 + 128 words);
+     * a draw that only reads words 960..999 does not wrap, so it is dumped
+     * and replaced from its upload. A draw past the edge and a page dump of
+     * that page still fall back. */
+    config(root,"DumpTextureWidthThreshold: 1\nDumpTextureHeightThreshold: 1\nReducePaletteRange: false\n");
+    std::vector<uint16_t> vram(1024*512); place(vram,960,432,40,words(40*64)); place(vram,0,500,256,words(256));
+    auto q = query(vram,960,256,1,0,79,176,239,0,500); char error[512]{};
+    auto pack = create(root);
+    check(duck_texture_pack_track_upload(pack.get(),960,432,40,64,vram.data(),vram.size()) == 1,"track an upload in the 8-bit edge page");
+    check(duck_texture_pack_dump_draw(pack.get(),&q,0,error,sizeof(error)) == HD_TEXTURE_LOOKUP_FOUND,"edge-page 8-bit draw inside VRAM is dumped");
+    pack.reset();
+    fs::path dumped;
+    if (fs::is_directory(root/"dumps")) for (const auto& entry : fs::directory_iterator(root/"dumps")) dumped = entry.path();
+    check(!dumped.empty() && dumped.filename().u8string().rfind("texupload-P8-",0) == 0,"edge-page dump is a P8 texupload");
+    if (dumped.empty()) return;
+    png(root/"replace"/"replacements"/dumped.filename(),160,128);
+    pack = create(root/"replace"); DuckTextureMatch match{};
+    check(duck_texture_pack_track_upload(pack.get(),960,432,40,64,vram.data(),vram.size()) == 1,"track the upload again for the replacement");
+    check(duck_texture_pack_match(pack.get(),&q,&match) == HD_TEXTURE_LOOKUP_FOUND,"edge-page 8-bit draw inside VRAM is replaced");
+    q.u_last = 255;   /* words 960..1087: past the edge */
+    check(duck_texture_pack_match(pack.get(),&q,&match) == HD_TEXTURE_LOOKUP_NONE,"edge-page draw past VRAM's edge falls back");
+    config(root/"pages","DumpTexturePages: true\nDumpTextureWidthThreshold: 1\nDumpTextureHeightThreshold: 1\n");
+    pack = create(root/"pages"); q.u_last = 79;
+    check(duck_texture_pack_dump_draw(pack.get(),&q,0,error,sizeof(error)) == HD_TEXTURE_LOOKUP_NONE,"no page dump of a page past VRAM's edge");
+}
