+/* Vertically double-buffered titles keep both framebuffers at one base_x
+ * (Dragon Valor: 0,0 and 0,256), so the source buffer's wide surface is the
+ * target surface itself, one y band away. A draw must not sample the texture
+ * it renders to, so the source band is first copied into this scratch
+ * texture, same size and coordinates as the wide surface. */
+static GLuint s_fb_scratch_tex = 0, s_fb_scratch_fbo = 0;
+static int    s_fb_scratch_w = 0, s_fb_scratch_h = 0;
+
+static int fb_scratch_ready(int w, int h) {
+    if (s_fb_scratch_fbo && s_fb_scratch_w == w && s_fb_scratch_h == h) return 1;
+    if (s_fb_scratch_fbo) { p_glDeleteFramebuffers(1, &s_fb_scratch_fbo); s_fb_scratch_fbo = 0; }
+    if (s_fb_scratch_tex) { glDeleteTextures(1, &s_fb_scratch_tex); s_fb_scratch_tex = 0; }
+    s_fb_scratch_w = s_fb_scratch_h = 0;
+    s_fb_scratch_tex = make_tex(GL_RGBA8, w, h, GL_RGBA, GL_UNSIGNED_BYTE);
+    if (!s_fb_scratch_tex) return 0;
+    if (!make_fbo(&s_fb_scratch_fbo, s_fb_scratch_tex, 0)) {
+        glDeleteTextures(1, &s_fb_scratch_tex);
+        s_fb_scratch_tex = 0;
+        s_fb_scratch_fbo = 0;
+        return 0;
+    }
+    s_fb_scratch_w = w;
+    s_fb_scratch_h = h;
+    return 1;
+}
