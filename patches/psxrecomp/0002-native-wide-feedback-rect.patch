+static uint16_t *wide_surf_existing(int base_x) {
+    if (g_wide_w <= 0) return NULL;
+    for (int i = 0; i < WIDE_MAX_SURF; i++)
+        if (g_wide_surf[i] && g_wide_base[i] == base_x) return g_wide_surf[i];
+    return NULL;
