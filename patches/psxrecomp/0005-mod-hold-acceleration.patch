     return 1;
 }
 
+extern "C" int psx_mod_hold_acceleration(
+    int held, uint32_t wall_clock_multiplier) {
+    if (wall_clock_multiplier == 1 ||
+        wall_clock_multiplier > PSX_MOD_LOAD_ACCEL_MAX) {
+        std::fprintf(stderr,
+            "psxrecomp: mod rejected acceleration hold (multiplier %u)\n",
+            (unsigned)wall_clock_multiplier);
+        return 0;
+    }
+    g_mod_accel_hold = held ? 1 : 0;
+    g_mod_accel_hold_multiplier = (int)wall_clock_multiplier;
+    return 1;
+}
