diff --git a/runtime/tests/test_mod_accel_hold.py b/runtime/tests/test_mod_accel_hold.py
new file mode 100644
--- /dev/null
+++ b/runtime/tests/test_mod_accel_hold.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Guard the mod-held acceleration span (psx_mod_hold_acceleration)."""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+MAIN = (ROOT / "runtime/src/main.cpp").read_text(encoding="utf-8")
+HEADER = (ROOT / "runtime/include/mod_plugins.h").read_text(encoding="utf-8")
+
+assert "int psx_mod_hold_acceleration(int held, uint32_t wall_clock_multiplier);" in HEADER
+assert "held = 0 ends the span: authentic pacing from the next VBlank." in HEADER
+# Released at every session start, with the load-acceleration request.
+assert """g_mod_load_release_frames = -1;
+        g_mod_accel_hold = 0;
+        g_mod_accel_hold_multiplier = 0;""" in MAIN
+# Never in netplay or self-check resimulation.
+assert """if (g_mod_accel_hold && !psx_netplay_active() &&
+        !psx_selfcheck_resim_active()) {""" in MAIN
+# Its accelerated audio is sunk even when no load acceleration is configured,
+# and it is paced at its own multiplier.
+assert "(g_turbo_audio_sink_enabled || mod_hold_active)" in MAIN
+assert "g_frame_period_ms / (double)g_mod_accel_hold_multiplier" in MAIN
+assert "} else if (g_turbo_load_wall_multiplier >= 2 &&" in MAIN
+print("ok")
