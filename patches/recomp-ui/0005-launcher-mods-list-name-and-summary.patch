+/* A feature's one-line summary for the list: the first sentence of its
+ * description, cut to `width` pixels with an ellipsis (whole UTF-8
+ * characters). */
+static std::string mod_summary_line(const char* description, float width) {
+    std::string s = description ? description : "";
+    const size_t end = s.find(". ");
+    if (end != std::string::npos) s.resize(end + 1);
+    if (ImGui::CalcTextSize(s.c_str()).x <= width) return s;
+    while (!s.empty() && ImGui::CalcTextSize((s + "...").c_str()).x > width) {
+        while (!s.empty() && (static_cast<unsigned char>(s.back()) & 0xC0) == 0x80) s.pop_back();
+        if (!s.empty()) s.pop_back();   /* the character's lead byte */
+    }
+    while (!s.empty() && s.back() == ' ') s.pop_back();
+    return s + "...";
+}
