+// Keyboard/pad navigation moves the selection without ImGui's own nav, so
+// nothing scrolls the page on its own: when the selected row sits outside the
+// visible area of its child window, bring it in (just after the row's
+// Selectable, which is then ImGui's "last item").
+void keep_selected_row_visible() {
+    const ImVec2 mn = ImGui::GetItemRectMin();
+    const ImVec2 mx = ImGui::GetItemRectMax();
+    const ImVec2 wmn = ImGui::GetWindowPos();
+    const ImVec2 wsz = ImGui::GetWindowSize();
+    if (mn.y < wmn.y) ImGui::SetScrollHereY(0.0f);
+    else if (mx.y > wmn.y + wsz.y) ImGui::SetScrollHereY(1.0f);
+}
+
+// The selected row's frame: the Selectable's header fill is subtle on
+// purpose (hover and selection share it), so the cursor row also gets an
+// accent outline and a bar on its left edge.
+void draw_selected_row_frame(const LauncherTheme &theme, const ImVec2 &a,
+                             const ImVec2 &b) {
+    ImDrawList *dl = ImGui::GetWindowDrawList();
+    dl->AddRect(a, b, u32(theme.accent2, 0.9f), theme.radius_sm, 0, 1.5f);
+    dl->AddRectFilled(a, ImVec2(a.x + 3.0f, b.y), u32(theme.accent2),
+                      theme.radius_sm);
+}
